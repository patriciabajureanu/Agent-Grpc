{
     "Logging": {
          "LogLevel": {
               "Default": "Information",
               "Microsoft.AspNetCore": "Warning",
               "Microsoft.Hosting.Lifetime": "Information"
          }
     },
     "AllowedHosts": "*",
     "Persistence": {
          "BackupPath": "news-backup.json",
          "IntervalSeconds": 5
     },
     "Delivery": {
          "MaxAttempts": 5,
          "BaseDelayMs": 1000,
          "MaxDelayMs": 30000,
          "PollIntervalMs": 2000,
          "DeadLetterPath": "dead-letter.jsonl"
     },
     "Kestrel": {
          "EndpointDefaults": {
               "Protocols": "Http1AndHttp2"
          }
     }
}