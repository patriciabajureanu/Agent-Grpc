{
     "Logging": {
          "LogLevel": {
               "Default": "Information",
               "Microsoft.AspNetCore": "Information"
          }
     },
     "AllowedHosts": "*",
     "Persistence": {
          "BackupPath": "news-backup.json",
          "IntervalSeconds": 5
     },
     "Kestrel": {
          "EndpointDefaults": {
               "Protocols": "Http2"
          }
     }
}