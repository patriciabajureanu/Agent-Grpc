# Variabilele de mediu citite de aplicatie. Toate sunt optionale; valorile de mai jos sunt cele implicite.
# Proiectul nu foloseste secrete: certificatul HTTPS de dezvoltare este in magazinul de certificate al utilizatorului.

# Adresa Broker-ului (folosita de Broker pentru ascultare si de Sender/Receiver pentru conectare).
BROKER_ADDRESS=https://localhost:5001

# Jurnalul Receiver-ului (implicit received-<categorie>.jsonl in directorul curent).
RECEIVER_JOURNAL=received-sport.jsonl

# Broker: backup-ul stirilor persistente.
Persistence__BackupPath=news-backup.json
Persistence__IntervalSeconds=5

# Broker: politica de livrare si dead-letter.
Delivery__MaxAttempts=5
Delivery__BaseDelayMs=1000
Delivery__MaxDelayMs=30000
Delivery__PollIntervalMs=2000
Delivery__DeadLetterPath=dead-letter.jsonl
